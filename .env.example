# Cloud backend only. Never copy these secrets into the Electron app.
PORT=8787
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Gateway Cloud AI. BẮT BUỘC nếu muốn bộ cài có Cloud AI: giá trị được nhúng vào binary
# lúc dựng (một biến chỉ nằm trong env của người dựng thì không tồn tại trên máy đã cài).
# Đặt sai/để trống thì bản cài trả lời "Cloud AI chưa được cấu hình trên bản cài này".
EDUGAME_AI_GATEWAY_URL=http://127.0.0.1:8788

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

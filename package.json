{
  "name": "edugame-studio",
  "version": "0.3.0",
  "description": "EduGame Studio - Ã¡Â»Â©ng dÃ¡Â»Â¥ng Windows tÃ¡ÂºÂ¡o, quÃ¡ÂºÂ£n lÃƒÂ½ vÃƒÂ  chÃ†Â¡i game giÃƒÂ¡o dÃ¡Â»Â¥c offline, TypeScript",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "author": "EduGame Studio",
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"try{require('node:fs').rmSync('dist',{recursive:true,force:true})}catch(e){console.warn('clean warning:',e.message)}\"",
    "build": "npm run clean && node scripts/build-icon-data.js --bootstrap && tsc -p tsconfig.json && npm run build:icons && tsc -p tsconfig.json && npm run build:icons:check && copyfiles -u 1 \"src/index.html\" \"src/renderer/styles/*.css\" \"src/presentation/presentation.html\" \"src/presentation/presentation-preload.js\" \"src/lan/mobile/*\" dist/src && npm run build:css && npm run build:three",
    "build:css": "tailwindcss -i src/renderer/styles/app.css -o dist/src/renderer/styles/app.css --minify",
    "build:three": "node scripts/build-three.js",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node tests/run-unit.js",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --dir",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "node dist/server/index.js",
    "server:build": "tsc -p tsconfig.json",
    "verify:css": "node tests/manual/verify-css.js",
    "check:renderer-globals": "node scripts/check-renderer-undefined-globals.js",
    "check:item-assets-ui": "node tests/ui/ui-item-assets-editor-check.js",
    "check:draft-guard-ui": "node tests/ui/ui-draft-guard-check.js",
    "check:settings-sections-ui": "node tests/ui/ui-settings-sections-check.js",
    "test:ui": "node tests/ui/ui-setup-fullscreen-check.js",
    "build:icons": "node scripts/build-icon-data.js",
    "build:icons:check": "node scripts/build-icon-data.js --check",
    "check:stage-illustration-ui": "node tests/ui/ui-stage-illustration-check.js",
    "check:play-surface-ui": "node tests/ui/ui-play-surface-check.js",
    "check:offline-packaged": "node tests/ui/offline-packaged-check.js",
    "check:presentation-ui": "node tests/ui/ui-presentation-check.js",
    "launch:ui": "powershell -ExecutionPolicy Bypass -File tests/ui/launch-app.ps1",
    "test:native": "node tests/run-unit.js lesson-store"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "better-sqlite3": "^11.7.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "pdf-parse": "1.1.1",
    "socket.io": "^4.8.4",
    "three": "^0.187.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "copyfiles": "^2.4.1",
    "daisyui": "^5.7.50",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "vn.edugame.studio",
    "productName": "EduGame Studio",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/@types/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.map",
      "!node_modules/**/{test,tests,__tests__,docs,example,examples}/**"
    ],
    "extraResources": [
      {
        "from": "vendor/vc-runtime",
        "to": "vc-runtime",
        "filter": [
          "*.dll"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "npmRebuild": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "EduGame-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
